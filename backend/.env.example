# Gemelo Digital de Infraestructura Verde Urbana - Environment Configuration
# Copy this file to .env and fill in your values

# Project Information
PROJECT_NAME=Gemelo Digital Infraestructura Verde
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bd_gemelodigital
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bd_gemelodigital_test
USE_TIMESCALEDB=false  # Set to false on Windows (TimescaleDB not available)

# Redis
REDIS_URL=redis://localhost:6379/0

# ENVI-met Configuration
ENVI_MET_PATH=/path/to/envi-met
ENVI_MET_LICENSE=/path/to/envi-met/license

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Environment
ENVIRONMENT=development

# Email (for password recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@gemelodigital.com

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Simulation
SIMULATION_TIMEOUT_MINUTES=120
MAX_CONCURRENT_SIMULATIONS=5

# Report Generation
REPORT_TEMP_DIR=./temp/reports
REPORT_MAX_SIZE_MB=50
