# Root Dockerignore - Optimize Build Context
.git
.gitignore
.vscode
.idea

# Frontend artifacts & dependencies (Avoid sending 1GB+ node_modules to daemon)
frontend/node_modules
frontend/.next
frontend/out
frontend/.cache
frontend/*.tsbuildinfo

# Python artifacts
__pycache__
*.py[cod]
*$py.class
.venv
venv
env
.pytest_cache
.coverage
htmlcov

# Logs and temp
logs/*.log
logs/app.log
temp/*
tmp/*

# OS files
.DS_Store
Thumbs.db
